# ==========================================================
# 生产环境变量（Vercel 部署时同样配置这些键，值换成线上后端地址）
# ==========================================================

# ★ 部署到 Vercel 后，唯一需要改的地方：把这里换成线上后端地址
VITE_API_BASE_URL=https://your-backend-domain.com/api/v1

VITE_API_TIMEOUT=15000

# 生产环境关闭 mock，走真实接口
VITE_USE_MOCK=false

VITE_APP_TITLE=猫球约 · 校园AI约球平台
