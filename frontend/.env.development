# ==========================================================
# 开发环境变量（vite 只暴露 VITE_ 前缀的变量）
# 后端地址变化时，只需要改这里的 VITE_API_BASE_URL 一处
# ==========================================================

# 后端接口基础地址（注意要带 /api/v1，且不要以 / 结尾）
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# 请求超时（毫秒）
VITE_API_TIMEOUT=15000

# 是否启用内置 mock 数据（true=纯前端演示，不连后端；联调/上线请设为 false）
VITE_USE_MOCK=true

# 站点标题（浏览器标签）
VITE_APP_TITLE=猫球约 · 校园AI约球平台
