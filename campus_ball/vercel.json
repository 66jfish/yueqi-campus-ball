{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "20mb",
        "memory": 1024,
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "crons": [
    {
      "path": "/api/v1/system/cron/daily",
      "schedule": "0 3 * * *"
    }
  ]
}
