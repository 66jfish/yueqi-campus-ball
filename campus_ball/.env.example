# ==========================================================
# 环境变量示例（后端）
# 本地：复制为 .env 使用；线上：填到 Vercel 后台（见 docs/DEPLOY_VERCEL_TIDB.md）
# ==========================================================

# ---------- 基础 ----------
PROJECT_NAME=猫球约 · 校园AI约球平台
ENV=prod
DEBUG=false
API_V1_PREFIX=/api/v1

# ---------- 部署形态 ----------
# Vercel Serverless 部署必须为 true：会关闭进程内定时任务（Serverless 无法常驻），
# 改为「惰性判断 + Vercel Cron」兜底；同时自动启用 NullPool
SERVERLESS_MODE=true
# 定时任务凭证：Vercel Cron 会以 Authorization: Bearer <CRON_SECRET> 自动携带
# 留空则 /api/v1/system/cron/daily 一律拒绝（安全默认）
CRON_SECRET=

# ---------- 数据库（TiDB Cloud Serverless）----------
# 主机/端口/用户/密码在 TiDB Cloud 控制台 → Clusters → Connect 中获取
# TiDB Cloud Serverless 的 host 形如：gateway01.<region>.prod.aws.tidbcloud.com，端口 4000
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=campus_ball
DB_CHARSET=utf8mb4
DB_ECHO=false

# TiDB Cloud 强制 TLS → true；Serverless 用 NullPool（无需连接池）
DB_REQUIRE_SSL=true
DB_SSL_CA=
DB_USE_NULL_POOL=true

# 常驻进程（本地 / 容器）时的连接池参数，Serverless 下不生效
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- JWT 登录鉴权 ----------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=campus-ball
JWT_AUDIENCE=campus-ball-client
JWT_LEEWAY_SECONDS=30
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# ---------- 密码哈希（bcrypt）----------
BCRYPT_ROUNDS=12

# ---------- 认证中间件 ----------
AUTH_ENABLED=true
AUTH_HEADER_NAME=Authorization
AUTH_TOKEN_PREFIX=Bearer
AUTH_COOKIE_NAME=access_token
AUTH_OPTIONAL_IGNORE_INVALID=true

# ---------- 信誉分 / 小黑屋业务规则 ----------
CREDIT_SCORE_INIT=100
CREDIT_SCORE_MIN=0
CREDIT_SCORE_MAX=150
CREDIT_BAN_THRESHOLD=60
BAN_DEFAULT_DAYS=3
BAN_ON_ABSENT=true
BAN_EXTEND_ON_REPEAT=true
BAN_MAX_TOTAL_DAYS=30
BAN_BLOCK_ALL_WRITES=false
BLACKLIST_FAIL_OPEN=true
BLACKLIST_CACHE_TTL=60

# ---------- 缺席判定兜底扫描 ----------
# Serverless 下进程内扫描不生效，这两个参数仅对常驻形态有意义；
# 线上由 Vercel Cron 每日调用 /api/v1/system/cron/daily 兜底
ABSENT_SCAN_ENABLED=true
ABSENT_SCAN_INTERVAL_SECONDS=3600
ABSENT_SCAN_BATCH_SIZE=50
ABSENT_SCAN_GRACE_MINUTES=0

# ---------- AI 信誉画像（DeepSeek）----------
AI_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=15
AI_PROFILE_TRIGGER_ON_SETTLE=true
AI_PROFILE_CACHE_HOURS=24
AI_PROFILE_SCAN_INTERVAL_SECONDS=600
AI_PROFILE_SCAN_BATCH_SIZE=20
AI_PROFILE_ASYNC_REFRESH=true
AI_MATCH_SCORE_ENABLED=true

# ---------- 跨域 CORS（★前端 Vercel 域名必须加进来）----------
# 多个用英文逗号分隔；不要用 * （带凭据的请求会被浏览器拒绝）
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
